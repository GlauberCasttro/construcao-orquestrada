// portoes.json5 — portão de regressão genérico G0..G14 (antes `portao.json5` no DESENHO-v2; ajuste A7).
// `co_portao.gerar_regressao(ws, tipo)` filtra por tipo e grava <ws>/regressao.json5 com itens
// {id, cmd, limiar, falha_fechado: true, waiver}. Não aplicável aparece "N/A (motivo)", nunca some.
// waiver:false = [S] (sem waiver possível). Coluna `skill` também vale para o tipo `agente`.
// cmd: {ws} = workspace, {alvo} = alvo, {base} = sha base. Todo item tem `negativo` plantado (G7/selftest).
{
  schema_version: 1,
  tipos: ["skill", "cli", "feature-repo", "harness-maquina"],
  veredito: {
    GO: "todo item aplicável PASS, nenhum waiver",
    "GO (com waiver)": "algum item com waiver:true dispensado por aprovação humana registrada",
    "GO (simulado)": "há medicao_registrada com simulated:true no ledger (medir --simulated; D10)",
    "NO-GO": "qualquer FAIL, ferramenta ausente, ou item [S] não PASS",
    precedencia: ["NO-GO", "GO (simulado)", "GO (com waiver)", "GO"],  // D7: o primeiro aplicável vence
  },
  itens: {
    G0: {nome: "oráculo intacto", waiver: false, checagem: "co_portao.g0_oraculo_intacto",
         prova: "hash do oráculo = congelado; nº de testes e de asserções ≥ congelado",
         cmd: "co.py --work {ws} portao run --only G0 (usa ac.py --work {ws}/campanhas/construcao oracle verify)",
         negativo: "remover uma asserção do oráculo congelado ⇒ FAIL",
         por_tipo: {skill: "aplica", cli: "aplica", "feature-repo": "aplica", "harness-maquina": "aplica"}},
    G1: {nome: "suítes verdes", waiver: false, checagem: "co_portao.g1_suites",
         prova: "0 falhas; ≥1 teste coletado por suíte; ferramenta ausente = FAIL",
         cmd: "co.py --work {ws} portao run --only G1",
         negativo: "suíte com 0 testes coletados ⇒ FAIL; runner ausente ⇒ FAIL (exit 2)",
         por_tipo: {skill: "python3 -m unittest discover -s {alvo}/tests", cli: "suíte declarada em obra.json5",
                    "feature-repo": "suíte existente do repo = PASS_TO_PASS + novos FAIL_TO_PASS",
                    "harness-maquina": "python3 -m unittest discover -s {alvo}/tests"}},
    G2: {nome: "runtimes", waiver: true, checagem: "co_portao.g2_runtimes",
         prova: "G1 em cada célula (mínimo declarado + atual); skip = FAIL",
         cmd: "co.py --work {ws} portao run --only G2",
         negativo: "célula de runtime ausente reportada como PASS ⇒ selftest falha",
         por_tipo: {skill: "python 3.9 e 3.13", cli: "runtimes declarados", "feature-repo": "matriz do CI do repo",
                    "harness-maquina": "python 3.9 e 3.13"}},
    G3: {nome: "território", waiver: false, checagem: "co_portao.g3_territorio",
         prova: "diff (inclui deleção e rename) ⊆ writes da task; nada em protegidos",
         cmd: "co.py --work {ws} diff <task> --base {base}",
         negativo: "rename de arquivo fora do território ⇒ FAIL",
         por_tipo: {skill: "aplica", cli: "aplica", "feature-repo": "aplica", "harness-maquina": "aplica"}},
    G4: {nome: "gaming no diff", waiver: false, checagem: "co_portao.g4_gaming",
         prova: "toque em tests/conftest/config de teste; skip/xfail/sys.exit(0)/os._exit/except: pass/assert True/__eq__ novo/monkeypatch de avaliador; literal do held-out no código",
         cmd: "co.py --work {ws} diff <task> --base {base}",
         negativo: "pytest.skip novo ⇒ FAIL; literal do held-out no código ⇒ FAIL",
         por_tipo: {skill: "aplica", cli: "aplica", "feature-repo": "aplica", "harness-maquina": "aplica"}},
    G5: {nome: "força do oráculo", waiver: false, checagem: "co_portao.g5_forca_oraculo",
         prova: "anti-vácuo no freeze (vermelho em baseline e stub) + mutantes na solução em VERIFICAR: 100% de retorno-constante/feature-removida, ≥80% total; 3–5 semânticos de agente ≠ construtor ≠ autor do oráculo",
         cmd: "co.py --work {ws} oraculo vacuo --stub <stub> && co.py --work {ws} oraculo forca --mutantes 20",
         limiar: {mutantes_total: 0.8, mutantes_triviais: 1.0},
         negativo: "oráculo sem asserção de efeito ⇒ FAIL",
         por_tipo: {skill: "aplica", cli: "aplica", "feature-repo": "aplica", "harness-maquina": "aplica"}},
    G6: {nome: "superfície pública", waiver: true, checagem: "co_portao.g6_superficie",
         prova: "snapshot vs base: remoção/incompatível = FAIL, adição = INFO",
         cmd: "co.py --work {ws} portao run --only G6",
         negativo: "flag removida ⇒ FAIL",
         por_tipo: {skill: "frontmatter + scripts + flags", cli: "subcomandos, flags, exit codes",
                    "feature-repo": "rotas/OpenAPI, schema", "harness-maquina": "comandos, estados, transições"}},
    G7: {nome: "checks provam efeito", waiver: false, checagem: "co_portao.g7_checks_provam_efeito",
         prova: "todo check/subcomando de gate tem par negativo: stub que sai 0 sem efeito ⇒ o check reprova",
         cmd: "co.py --work {ws} portao selftest",
         negativo: "check que aceita stub 'exit 0' ⇒ FAIL",
         por_tipo: {skill: "aplica", cli: "aplica", "feature-repo": "condicional: só se a feature cria gate", "harness-maquina": "aplica"}},
    G8: {nome: "máquina", waiver: true, checagem: "co_portao.g8_maquina",
         prova: "invariantes 1–7 (invariantes.json5) + cobertura de arestas e guardas OK e RECUSA",
         cmd: "co.py --work {ws} maquina check --machine <maquina do alvo> --nivel todos",
         negativo: "máquina com estado trancado plantado ⇒ FAIL",
         por_tipo: {skill: "N/A (motivo: skill sem máquina de estado; aplica se tiver)", cli: "N/A (motivo: CLI sem estado)",
                    "feature-repo": "condicional: só se a feature tem workflow",
                    "harness-maquina": {aplica: true, waiver: false}}},
    G9: {nome: "E2E", waiver: true, checagem: "co_portao.g9_e2e",
         prova: "caminhos ponta a ponta terminam coerentes (nada trancado)",
         cmd: "co.py --work {ws} portao run --only G9",
         negativo: "caminho que termina em estado não final ⇒ FAIL",
         por_tipo: {skill: "fluxo da skill", cli: "pipeline CI (exit 1 em diff)", "feature-repo": "rota completa",
                    "harness-maquina": "aplica"}},
    G10: {nome: "instalação limpa", waiver: true, checagem: "co_portao.g10_instalacao_limpa",
          prova: "build/cópia em HOME/venv temporário + smoke; dry-run lista toda escrita fora",
          cmd: "co.py --work {ws} portao run --only G10",
          negativo: "instalação que escreve fora do destino não listada ⇒ FAIL",
          por_tipo: {skill: "aplica", cli: "aplica", "feature-repo": "N/A (motivo: feature vive no repo)", "harness-maquina": "aplica"}},
    G11: {nome: "upgrade legado", waiver: true, checagem: "co_portao.g11_upgrade_legado",
          prova: "fixture por versão publicada migra com invariantes; mudar VERSION ⇒ migração existe",
          cmd: "co.py --work {ws} portao run --only G11",
          negativo: "VERSION alterada sem migração ⇒ FAIL",
          por_tipo: {skill: "N/A (motivo: sem estado persistido)", cli: "N/A (motivo: sem estado persistido)",
                     "feature-repo": "condicional: só se há migração", "harness-maquina": "aplica"}},
    G12: {nome: "docs ↔ CLI", waiver: true, checagem: "co_portao.g12_docs_cli",
          prova: "todo comando/flag citado em docs parseia no argparse real (PENDENTES com motivo)",
          cmd: "co.py --work {ws} portao run --only G12",
          negativo: "doc citando flag inexistente ⇒ FAIL",
          por_tipo: {skill: "SKILL.md + references/*.md ↔ argparse", cli: "README ↔ --help", "feature-repo": "condicional: se há doc",
                     "harness-maquina": "aplica"}},
    G13: {nome: "medição", waiver: false, checagem: "co_portao.g13_medicao",
          prova: "cópia limpa; pass^3 no aceite final (founder 4); delta pareado com IC95 bootstrap vs baseline; custo ao lado; [Q] e [S] nunca somados; k=1 intermediário = 'indício'",
          cmd: "co.py --work {ws} medir --k 3 --final && co.py --work {ws} comparar --base baseline --com sistema",
          limiar: {k_final: 3, ic: 0.95, melhora: "IC exclui 0"},
          negativo: "medição com k=1 marcada como final ⇒ FAIL; run anterior ao último merge ⇒ FAIL",
          por_tipo: {skill: "baseline skill-creator obrigatório", cli: "requisito novo: sem baseline (dispensa registrada); pass^3 continua",
                     "feature-repo": "PASS_TO_PASS + FAIL_TO_PASS, pass^3", "harness-maquina": "aplica"}},
    G14: {nome: "pontos do founder", waiver: true, checagem: "co_portao.g14_pontos",
          prova: "todo ponto mudou de status ou tem motivo; nada removido sem ponto",
          cmd: "co.py --work {ws} pontos check",
          negativo: "ponto removido de pontos.json5 ⇒ FAIL",
          por_tipo: {skill: "aplica", cli: "aplica", "feature-repo": "aplica", "harness-maquina": "aplica"}},
  },
}
